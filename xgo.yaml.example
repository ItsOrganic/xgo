watch:
  dirs: [".", "./pkg", "./templates"]
  include: ["*.go", "*.html", "*.env"]
  exclude: ["*_test.go", "vendor/", "*.pb.go"]
  debounce: 50ms

build:
  cmd: "go build -o ./tmp/xgo-app ."
  env: ["CGO_ENABLED=0"]
  timeout: 30s

run:
  cmd: "./tmp/xgo-app"
  args: ["--port", "8080"]
  env: ["PORT=8080", "ENV=development"]
  before: ["go generate ./..."]
  after: []

extra_cmds:
  - cmd: "npm run watch"
    dir: "./frontend"

log:
  timestamps: true
  color: true
  prefix: "[xgo]"
